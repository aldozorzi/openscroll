# Local database (docker compose)
DATABASE_URL=postgresql://openscroll:openscroll@localhost:5432/openscroll
DIRECT_URL=postgresql://openscroll:openscroll@localhost:5432/openscroll

# Authentication
AUTH_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
CRON_SECRET=dev-only-change-me-cron-0123456789abcdef0123456789
ADMIN_TOKEN=dev-only-change-me-admin-0123456789abcdef0123456789

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="OpenScroll <onboarding@resend.dev>"

# Verification mail can use a separate key/sender so registration abuse cannot
# exhaust the password-reset stream or damage its sender reputation. Both fall
# back to RESEND_API_KEY / EMAIL_FROM when left empty.
RESEND_VERIFICATION_API_KEY=
EMAIL_VERIFICATION_FROM=
# Hard global cap on verification emails per 24 hours (all addresses).
VERIFICATION_EMAIL_DAILY_LIMIT=50

# Cloudflare Turnstile (registration CAPTCHA)
# Set both keys to enable. In production, registration returns 503 while they
# are missing; in development the widget is shown but failures are not blocking.
# Official test keys: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Embeddings (Cloudflare Workers AI)
EMBEDDING_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIM=1024

# LLM provider (google | cloudflare | openrouter | mock)
LLM_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite

# OpenRouter (LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=OpenScroll

# Zero-cost guardrails
MAX_LLM_TOKENS_PER_DAY=200000
MAX_EMBEDDING_TOKENS_PER_DAY=1000000
LLM_DAILY_BUDGET_USD=0

# Retention
RAW_CONTENT_RETENTION_DAYS=7
CLEANED_CONTENT_RETENTION_DAYS=30

# Feed
FEED_FRESHNESS_HALF_LIFE_DAYS=14

# Optional cache/rate limiting (never for BullMQ)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional self-hosted BullMQ worker
REDIS_URL=

# Optional observability
SENTRY_DSN=

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to true ONLY when a trusted reverse proxy overwrites X-Forwarded-For,
# X-Real-IP or CF-Connecting-IP. Otherwise IP-based rate limits can be bypassed
# by spoofing those headers. When false, every client shares the "unknown" IP
# bucket, so IP limits behave as global limits.
TRUST_PROXY=false
